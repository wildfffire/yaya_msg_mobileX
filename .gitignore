!/member-db/dist/
!/member-db/dist/members.json

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# 日志与系统/IDE 垃圾文件
*.log
!docs/*.log
Thumbs.db
desktop.ini
.idea/
*.iml
*.hprof
*.bak
*.tmp

# generated native folders
/android/local.properties
/ios

# Android source is part of this app because it contains native player code.
android/.gradle/
android/build/
android/app/build/
*.apk
*.hsp
/harmonyos
src_backup_*
android/app/src/main/assets/

# HarmonyOS build outputs
harmony/entry/oh_modules/
harmony/node_modules/
harmony/.hvigor/
harmony/entry/build/
harmony/build/
harmony/AppScope/resources/base/media/
harmony/entry/src/main/resources/base/media/
harmony/entry/src/main/resources/rawfile/
harmony/local.properties
harmony/oh-package-lock.json5
harmony/entry/oh-package-lock.json5
*.hsp
*.hap

# opencode 本地工具配置（不入库）
.opencode/
opencode.json

# WorkBuddy local memory (not part of source)
.workbuddy/

# AI 助手本地数据（不入库）
.codebuddy/
.firecrawl/

# 开发过程产物（QA 截图 / UI dump / 临时图，不入库）
scratch/
_*.png
_*.xml
_*.log
android/app/.cxx/

# 本地原生模块构建产物
modules/*/android/build/
modules/*/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Gradle 本地缓存（含模块内的）
.gradle/

# 安装包 / 签名产物
*.aab
*.idsig

# IDE 本地配置（个人按键与索引，不入库）
.vscode/

# 本机 npm 源（国内镜像，仅本机加速；避免强加给所有克隆者与 CI）
/.npmrc

# 一次性 codemod / 补丁脚本归档（保留参考，不参与构建）
scripts/archive/

# 本地修复记录 / 复盘文档（只在本地保留，不公开）
docs/修复记录汇总.md
docs/修复报告-*.md
