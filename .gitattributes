# 仓库内统一 LF（与 .editorconfig 一致），避免 Windows 提交把整份文件变成 CRLF
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf

# 二进制：禁止任何换行/编码转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.wasm binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.so binary
*.mp3 binary
*.mp4 binary
*.zip binary
